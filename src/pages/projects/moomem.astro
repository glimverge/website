---
import {
	BookOpen01Icon,
	Brain01Icon,
	CloudOffIcon,
	DatabaseSync01Icon,
	Search01Icon,
	Share01Icon,
	SourceCodeIcon,
} from "@hugeicons/core-free-icons";
import Frame from "../components/Frame.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="moomem — 临界微光"
	description="MoonBit 嵌入式 Agent 记忆层。零部署、崩溃可恢复、按用户隔离。"
>
	<Frame>
		<article>
			<h1 class="font-serif text-[clamp(2.4rem,6vw,3.15rem)] leading-[1.15] font-medium tracking-tight">
				moomem
			</h1>
			<p class="mt-3.5 text-[0.95rem] text-muted-foreground">
				<span class="max-sm:block">MoonBit 嵌入式 Agent 记忆层。</span>
				<span class="max-sm:block">零部署、崩溃可恢复、按用户隔离。</span>
			</p>
			<p class="mt-3.5">
				Agent 进程一结束就失忆。moomem 嵌在宿主进程里，不用单独起服务。native
				上把记忆写进本地目录，关掉再打开还能召回。
			</p>
			<ul class="mt-[1.15rem] grid list-none gap-1.5 p-0 text-muted-foreground">
				<li class="flex items-start gap-2">
					<Icon class="mt-[0.28em]" icon={Brain01Icon} />
					<span>open、add、recall、forget</span>
				</li>
				<li class="flex items-start gap-2">
					<Icon class="mt-[0.28em]" icon={Share01Icon} />
					<span>导入、导出与统计</span>
				</li>
				<li class="flex items-start gap-2">
					<Icon class="mt-[0.28em]" icon={Search01Icon} />
					<span>向量与 BM25 混合检索，索引按用户分开</span>
				</li>
				<li class="flex items-start gap-2">
					<Icon class="mt-[0.28em]" icon={DatabaseSync01Icon} />
					<span>双槽快照，写入中途崩溃仍可恢复</span>
				</li>
				<li class="flex items-start gap-2">
					<Icon class="mt-[0.28em]" icon={CloudOffIcon} />
					<span>缺省离线，不需要 API Key</span>
				</li>
			</ul>
			<p class="mt-5 flex gap-5">
				<a class="inline-flex items-center gap-1.5 font-medium" href="https://github.com/glimverge/moomem">
					<Icon icon={SourceCodeIcon} />
					源码
				</a>
				<a class="inline-flex items-center gap-1.5 font-medium" href="https://mooncakes.io/docs/heyq02/moomem">
					<Icon icon={BookOpen01Icon} />
					文档
				</a>
			</p>
		</article>
	</Frame>
</Layout>
