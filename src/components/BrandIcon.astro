---
interface Props {
	icon: { path: string };
	size?: number;
	class?: string;
}

const { icon, size = 18, class: className } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="currentColor"
	aria-hidden="true"
	class:list={["block shrink-0", className]}
>
	<path d={icon.path} />
</svg>
