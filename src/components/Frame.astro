---
import { Folder01Icon, GithubIcon, Mail01Icon, Notebook01Icon, QuillWrite01Icon } from "@hugeicons/core-free-icons";
import logo from "../assets/logo-full-transparent.svg";
import Icon from "./Icon.astro";

const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="page">
	<header class="site-header">
		<a class="brand" href="/">
			<img src={logo.src} width="32" height="28" alt="" />
			<span>临界微光</span>
		</a>
		<nav class="header-nav" aria-label="站点">
			<a href="/moomem" aria-current={here === "/moomem" ? "page" : undefined}>
				<Icon icon={Folder01Icon} />
				项目
			</a>
			<a href="https://github.com/glimverge">
				<Icon icon={GithubIcon} />
				GitHub
			</a>
		</nav>
	</header>

	<main>
		<slot />
	</main>

	<footer class="site-footer">
		<a href="mailto:hello@glimverge.com">
			<Icon icon={Mail01Icon} />
			hello@glimverge.com
		</a>
		<nav aria-label="社交">
			<a href="https://github.com/glimverge">
				<Icon icon={GithubIcon} />
				GitHub
			</a>
			<a href="https://juejin.cn/user/4404007135100058">
				<Icon icon={QuillWrite01Icon} />
				掘金
			</a>
			<a href="https://www.xiaohongshu.com/user/profile/68fdd72c0000000037005231">
				<Icon icon={Notebook01Icon} />
				小红书
			</a>
		</nav>
		<p class="colophon">于细微处，见临界通</p>
	</footer>
</div>
